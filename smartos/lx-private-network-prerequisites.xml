<?xml version="1.0"?>
<!DOCTYPE service_bundle SYSTEM "/usr/share/lib/xml/dtd/service_bundle.dtd.1">
<service_bundle type="manifest" name="lx-private-network-prerequisites">
  <service name="site/lx-private-network-prerequisites" type="service" version="1">
    <create_default_instance enabled="true" />
    <single_instance />

    <dependency name="filesystem-local" grouping="require_all"
        restart_on="none" type="service">
      <service_fmri value="svc:/system/filesystem/local:default" />
    </dependency>
    <dependency name="network-physical" grouping="require_all"
        restart_on="none" type="service">
      <service_fmri value="svc:/network/physical:default" />
    </dependency>

    <dependent name="lx-private-network-zones" grouping="require_all"
        restart_on="none">
      <service_fmri value="svc:/system/zones:default" />
    </dependent>
    <dependent name="lx-private-network-vmadmd" grouping="require_all"
        restart_on="none">
      <service_fmri value="svc:/system/smartdc/vmadmd:default" />
    </dependent>

    <exec_method type="method" name="start"
        exec="/opt/custom/bin/lx-private-network-prerequisites start"
        timeout_seconds="60" />
    <exec_method type="method" name="stop"
        exec="/opt/custom/bin/lx-private-network-prerequisites stop"
        timeout_seconds="60" />

    <property_group name="startd" type="framework">
      <propval name="duration" type="astring" value="transient" />
    </property_group>

    <stability value="Unstable" />
    <template>
      <common_name>
        <loctext xml:lang="C">LX private-network host prerequisites</loctext>
      </common_name>
    </template>
  </service>
</service_bundle>
